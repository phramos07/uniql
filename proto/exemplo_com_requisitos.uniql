# =============================================================================
# UniQL v0.1 — programa-exemplo de requisitos
# STATUS: esboço de sintaxe; ainda NÃO é uma gramática nem um programa executável.
#
# Objetivo:
#   Mostrar, em um único arquivo, o que a linguagem precisa ser capaz de
#   expressar para harmonizar CIC-IDS2017, CSE-CIC-IDS2018 e
#   LycoS-Unicas-IDS2018 sem fazer o tratamento "na unha".
#
# Estilo:
#   - palavras-chave e expressões inspiradas em Python;
#   - blocos delimitados por chaves;
#   - comentários com #;
#   - True / False / None;
#   - snake_case como convenção de identificadores.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Configuração global
# -----------------------------------------------------------------------------

config {
    # Limpeza lexica dos nomes dos atributos.
    trim_column_names = True
    snake_case = True

    # Só faz mapeamento automático quando, após a normalização lexical,
    # o nome da coluna de origem for EXATAMENTE igual ao nome canônico.
    # Não há inferência "mágica" de equivalência semântica.
    auto_map = "normalized_exact"

    # Política whitelist: tudo que não for mapeado/produzido para o schema
    # canônico é descartado do resultado.
    drop_unmapped = True

    # Em ambiguidades ou violações de schema, falha em vez de adivinhar.
    strict = True
    on_mapping_conflict = "error"
    on_duplicate_target = "error"

    # Requisito não funcional importante para CSVs de vários GB.
    streaming = True
    chunk_size = 250_000

    # Toda transformação gera relatório de auditoria/proveniência.
    audit = True
}


# -----------------------------------------------------------------------------
# 2. Fontes de dados
# -----------------------------------------------------------------------------
# Uma fonte pode ser um CSV único ou um conjunto de CSVs por glob.
# O dialeto do CSV faz parte da especificação da fonte.

source cic17 = csv("data/CIC-IDS-2017/MachineLearningCVE/*.csv") {
    separator = ","
    encoding = "utf-8"
    header = True
    quote = "\""
    infer_types = True
    allow_schema_variants = True

    # Tokens que o leitor deve interpretar como ausência de valor.
    null_values = ["", "NaN", "nan", "NULL", "null"]
}

source cse18 = csv("data/CSE-CIC-IDS2018/Processed Traffic Data for ML Algorithms/*.csv") {
    separator = ","
    encoding = "utf-8"
    header = True
    quote = "\""
    infer_types = True
    allow_schema_variants = True
    null_values = ["", "NaN", "nan", "NULL", "null"]
}

source lycos18 = csv("data/LycoS-Unicas-IDS2018.csv") {
    separator = ","
    encoding = "utf-8"
    header = True
    infer_types = True
    null_values = ["", "NaN", "nan", "NULL", "null"]
}


# -----------------------------------------------------------------------------
# 3. Tipos e schema canônico
# -----------------------------------------------------------------------------
# Tipos escalares mínimos:
#   int, float, bool, string, category, date, time, datetime
#
# Tipos semânticos/unidades:
#   duration[us|ms|s], size[byte], rate[bytes_per_second],
#   rate[packets_per_second]
#
# "?" indica nullable.
# Modificadores:
#   required, optional, target
#
# OBS.: A escolha de milissegundos aqui é apenas para demonstrar conversão
#       de unidade. O schema definitivo pode preferir microssegundos.

schema nids_unified {
    dst_port: int optional

    flow_duration: duration[ms] required

    fwd_pkt_count: int required
    bwd_pkt_count: int required
    fwd_bytes_total: size[byte] required
    bwd_bytes_total: size[byte] required

    fwd_pkt_len_min: float required
    fwd_pkt_len_max: float required
    fwd_pkt_len_mean: float required
    fwd_pkt_len_std: float required

    bwd_pkt_len_min: float required
    bwd_pkt_len_max: float required
    bwd_pkt_len_mean: float required
    bwd_pkt_len_std: float required

    flow_iat_min: duration[us] optional
    flow_iat_max: duration[us] optional
    flow_iat_mean: duration[us] optional
    flow_iat_std: duration[us] optional

    syn_flag_count: int optional
    ack_flag_count: int optional
    fin_flag_count: int optional
    rst_flag_count: int optional

    # Exemplos de atributos derivados de forma padronizada.
    total_pkt_count: int optional
    total_bytes: size[byte] optional
    flow_pkt_rate: rate[packets_per_second]? optional
    flow_byte_rate: rate[bytes_per_second]? optional

    # O label é target, nunca feature de entrada X.
    label: category target required
}


# -----------------------------------------------------------------------------
# 4. Regras/funções reutilizáveis
# -----------------------------------------------------------------------------

rule safe_div(numerator: float, denominator: float) -> float? {
    if denominator == 0 {
        return None
    }

    return numerator / denominator
}


rule normalize_binary_label(value: string) -> category {
    # Harmonização mínima e reproduzível: benign vs attack.
    # Uma taxonomia multiclass pode ser definida em outra regra.
    if lower(trim(value)) == "benign" {
        return "benign"
    }

    return "attack"
}


rule normalize_non_negative(value: float) -> float? {
    # Exemplo de tratamento de sentinela.
    # Esta regra NÃO deve ser aplicada genericamente sem justificativa:
    # zero pode ser um valor perfeitamente válido em features de rede.
    if value < 0 {
        return None
    }

    return value
}


# -----------------------------------------------------------------------------
# 5. Transformação do CIC-IDS2017
# -----------------------------------------------------------------------------

transform cic17 -> nids_unified as cic17_u {

    # Caso real: CIC-IDS2017 contém Fwd Header Length duplicada.
    deduplicate columns {
        keep = "first"
        report = True
    }

    # Mapeia automaticamente somente nomes que, após trim + snake_case,
    # coincidem exatamente com um campo do schema.
    automap

    # Mapeamentos semânticos explícitos.
    map total_fwd_packets -> fwd_pkt_count
    map total_backward_packets -> bwd_pkt_count

    map total_length_of_fwd_packets -> fwd_bytes_total
    map total_length_of_bwd_packets -> bwd_bytes_total

    map fwd_packet_length_min -> fwd_pkt_len_min
    map fwd_packet_length_max -> fwd_pkt_len_max
    map fwd_packet_length_mean -> fwd_pkt_len_mean
    map fwd_packet_length_std -> fwd_pkt_len_std

    map bwd_packet_length_min -> bwd_pkt_len_min
    map bwd_packet_length_max -> bwd_pkt_len_max
    map bwd_packet_length_mean -> bwd_pkt_len_mean
    map bwd_packet_length_std -> bwd_pkt_len_std

    map flow_iat_min -> flow_iat_min
    map flow_iat_max -> flow_iat_max
    map flow_iat_mean -> flow_iat_mean
    map flow_iat_std -> flow_iat_std

    map syn_flag_count -> syn_flag_count
    map ack_flag_count -> ack_flag_count
    map fin_flag_count -> fin_flag_count
    map rst_flag_count -> rst_flag_count

    # Conversão explícita de unidade: fonte em microssegundos -> canônico em ms.
    convert flow_duration from us to ms

    # Tipagem explícita quando necessário.
    cast dst_port as int
    cast fwd_pkt_count as int
    cast bwd_pkt_count as int

    # Valores não finitos não entram silenciosamente no schema.
    replace [Inf, -Inf] with None in numeric_columns

    # Harmonização do alvo.
    map_values label using normalize_binary_label

    # Features derivadas com uma única fórmula canônica.
    derive total_pkt_count = fwd_pkt_count + bwd_pkt_count
    derive total_bytes = fwd_bytes_total + bwd_bytes_total
    derive flow_pkt_rate = safe_div(total_pkt_count * 1000.0, flow_duration)
    derive flow_byte_rate = safe_div(total_bytes * 1000.0, flow_duration)

    # Validações.
    require [flow_duration, fwd_pkt_count, bwd_pkt_count, label]
    assert flow_duration >= 0
    assert fwd_pkt_count >= 0
    assert bwd_pkt_count >= 0

    # Linhas que não satisfazem campos required não são "inventadas".
    missing required -> drop_row
}


# -----------------------------------------------------------------------------
# 6. Transformação do CSE-CIC-IDS2018
# -----------------------------------------------------------------------------

transform cse18 -> nids_unified as cse18_u {

    # Caso real observado: alguns CSVs têm o cabeçalho repetido no meio dos dados.
    drop_rows where label == "Label"

    # O dataset possui variantes de schema. Alguns arquivos têm Flow ID,
    # Src IP, Src Port e Dst IP; como drop_unmapped=True, esses campos não
    # entram no resultado, mas a regra explícita documenta a intenção.
    if has_column("flow_id") {
        drop flow_id
    }

    if has_column("src_ip") {
        drop src_ip
    }

    if has_column("src_port") {
        drop src_port
    }

    if has_column("dst_ip") {
        drop dst_ip
    }

    # Timestamp pode ser parseado/validado mesmo quando não integra o
    # schema final. Isso demonstra suporte a tipos de data/tempo.
    if has_column("timestamp") {
        parse timestamp as datetime format "%d/%m/%Y %H:%M:%S"
        drop timestamp
    }

    # Protocol não pertence ao núcleo v0.1 deste exemplo.
    if has_column("protocol") {
        cast protocol as int
        drop protocol
    }

    automap

    map tot_fwd_pkts -> fwd_pkt_count
    map tot_bwd_pkts -> bwd_pkt_count
    map totlen_fwd_pkts -> fwd_bytes_total
    map totlen_bwd_pkts -> bwd_bytes_total

    map fwd_pkt_len_min -> fwd_pkt_len_min
    map fwd_pkt_len_max -> fwd_pkt_len_max
    map fwd_pkt_len_mean -> fwd_pkt_len_mean
    map fwd_pkt_len_std -> fwd_pkt_len_std

    map bwd_pkt_len_min -> bwd_pkt_len_min
    map bwd_pkt_len_max -> bwd_pkt_len_max
    map bwd_pkt_len_mean -> bwd_pkt_len_mean
    map bwd_pkt_len_std -> bwd_pkt_len_std

    map syn_flag_cnt -> syn_flag_count
    map ack_flag_cnt -> ack_flag_count
    map fin_flag_cnt -> fin_flag_count
    map rst_flag_cnt -> rst_flag_count

    convert flow_duration from us to ms

    cast dst_port as int
    cast fwd_pkt_count as int
    cast bwd_pkt_count as int

    replace [Inf, -Inf] with None in numeric_columns
    map_values label using normalize_binary_label

    derive total_pkt_count = fwd_pkt_count + bwd_pkt_count
    derive total_bytes = fwd_bytes_total + bwd_bytes_total
    derive flow_pkt_rate = safe_div(total_pkt_count * 1000.0, flow_duration)
    derive flow_byte_rate = safe_div(total_bytes * 1000.0, flow_duration)

    require [flow_duration, fwd_pkt_count, bwd_pkt_count, label]
    assert flow_duration >= 0
    missing required -> drop_row
}


# -----------------------------------------------------------------------------
# 7. Transformação do LycoS-Unicas-IDS2018
# -----------------------------------------------------------------------------

transform lycos18 -> nids_unified as lycos18_u {

    automap

    map fwd_pkt_cnt -> fwd_pkt_count
    map bwd_pkt_cnt -> bwd_pkt_count
    map fwd_pkt_len_tot -> fwd_bytes_total
    map bwd_pkt_len_tot -> bwd_bytes_total

    map flag_syn -> syn_flag_count
    map flag_ack -> ack_flag_count
    map flag_fin -> fin_flag_count
    map flag_rst -> rst_flag_count

    convert flow_duration from us to ms

    cast dst_port as int
    cast fwd_pkt_count as int
    cast bwd_pkt_count as int

    replace [Inf, -Inf] with None in numeric_columns
    map_values label using normalize_binary_label

    derive total_pkt_count = fwd_pkt_count + bwd_pkt_count
    derive total_bytes = fwd_bytes_total + bwd_bytes_total
    derive flow_pkt_rate = safe_div(total_pkt_count * 1000.0, flow_duration)
    derive flow_byte_rate = safe_div(total_bytes * 1000.0, flow_duration)

    require [flow_duration, fwd_pkt_count, bwd_pkt_count, label]
    assert flow_duration >= 0
    missing required -> drop_row
}


# -----------------------------------------------------------------------------
# 8. Unificação dos benchmarks
# -----------------------------------------------------------------------------
# Aqui a concatenação é vertical (por linhas). Todos os datasets já aderem
# ao mesmo schema, mesma ordem, tipos e unidades.

dataset unified = concat_rows(cic17_u, cse18_u, lycos18_u) {
    require_same_schema = True
    preserve_source = True as "_source_dataset"
}


# -----------------------------------------------------------------------------
# 9. Validação final
# -----------------------------------------------------------------------------

validate unified against nids_unified {
    no_duplicate_columns = True
    all_required_present = True
    no_unmapped_columns = True
    no_infinite_values = True
}


# -----------------------------------------------------------------------------
# 10. Saída
# -----------------------------------------------------------------------------

export unified to csv("output/nids_unified.csv") {
    separator = ","
    encoding = "utf-8"
    header = True
    null = ""
    decimal = "."
    datetime_format = "%Y-%m-%dT%H:%M:%S"
    column_order = "schema"
}


# Relatório de reprodutibilidade/auditoria.
report unified to json("output/nids_unified.audit.json") {
    include = [
        "input_files",
        "input_schemas",
        "schema_variants",
        "automatic_mappings",
        "explicit_mappings",
        "dropped_columns",
        "dropped_rows",
        "casts",
        "unit_conversions",
        "derived_columns",
        "missing_value_actions",
        "assertions",
        "output_schema"
    ]
}
